{
  "name": "omega-alpha-spiral",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "esbuild": true
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:bot": "playwright test tests/bot-playtest.spec.ts --workers=1",
    "test": "npm run test:unit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs",
    "verify:visual": "python .agents/skills/threejs-game-director/scripts/check_evidence.py . --manifest artifacts/evidence.json --report artifacts/final-evidence.md",
    "prepare": "husky"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "lil-gui": "0.21.0",
    "nixie-fx": "^0.1.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.8",
    "stylelint": "17.15.0",
    "stylelint-order": "8.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
