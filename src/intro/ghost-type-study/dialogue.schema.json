{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Omega Studio dialogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "source", "events"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "speaker", "text"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "line"
              },
              "speaker": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 220
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "durationMs"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "wait"
              },
              "durationMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 60000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "label"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "continue"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene", "era", "layout", "voices"],
      "properties": {
        "scene": {
          "enum": ["opening", "floor1", "floor2", "floor3"]
        },
        "era": {
          "enum": ["phosphor", "dos", "gui", "smooth"]
        },
        "layout": {
          "enum": ["manuscript", "fragments", "passage"]
        },
        "voices": {
          "type": "object",
          "propertyNames": {
            "enum": ["omega", "light", "shadow", "ambition"]
          },
          "additionalProperties": {
            "$ref": "#/definitions/writing"
          }
        }
      }
    }
  },
  "definitions": {
    "writing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intervalMs": {
          "type": "number",
          "minimum": 15,
          "maximum": 200
        },
        "startDelayMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "jitter": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mistakeFrequency": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.35
        },
        "correctionDelayMs": {
          "type": "number",
          "minimum": 50,
          "maximum": 1500
        },
        "revisionDelayMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 3000
        }
      }
    }
  }
}
