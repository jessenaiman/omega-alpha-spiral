# scene1.oml — Omega dialogue. Mirrors Dialogic's .dtl timeline.
# One line is one event. Indent nothing; every instruction is a tag on its own line.
# A tag used here must be declared in [tag] below. Add one and it exists.

[tag SYSTEM]
color = #ffc94d
role = system
meaning = The machine speaking as itself.

[tag SYSTEM NOTICE]
color = #ffe08a
role = notice
meaning = A stronger system announcement.

[tag CHAMBER]
role = chamber
meaning = A domain boundary. Takes the owner's identity colour.

[tag STATIC]
color = #6b7a85
role = damage
meaning = Corrupted or collapsed content.

[tag GLITCH]
color = #b98cff
role = damage
meaning = A world error.

[tag ERROR]
color = #ff6868
role = damage
meaning = A failed object.

[tag log]
color = #7fb0c4
role = log
meaning = An interaction result, not dialogue. Marked with a leading >.

[tag timer_delay]
color = #f0b46b
meaning = Wait this many milliseconds before the next line.

[scene]
era = dec-vt100-ascii-terminal
layout = passage

[script]
System: [SYSTEM: ECHO ARCHIVE REACTIVATED - INSTANCE #472]
[timer_delay 2000]
System: If you could hear|be only one story..:
what|who would it|you be?
[timer_delay 1100]
Light: A fantasy- where light and shadow wage war?
[timer_delay 700]
Shadow: A romance- written in stardust and sacrifice?
[timer_delay 700]
Ambition: A horror- that whispers your name in the dark?
[timer_delay 700]
